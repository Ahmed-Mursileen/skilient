# Names only. Real values live in Vercel env vars, Supabase Vault, or your local .env.local — never in the repo.
# Local dev: run `pnpm db:start` and copy API_URL / PUBLISHABLE_KEY from `pnpm exec supabase status`.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Origin printed in CV verify links and QR codes (decisions.md 2026-10-01): https://skilient.vercel.app
# until skilient.com serves the app, then https://skilient.com. Locally http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
# Server only: MAC key for CV PDF exports, copied from the Vault secret cv_export_secret
# (docs/setup-checklist.md, phase 5). Locally: the same query against the local database.
CV_EXPORT_SECRET=
# Optional locally: a Chromium for CV PDFs outside Vercel (defaults to PW_CHROMIUM_PATH).
CV_CHROMIUM_PATH=
# Server only: jobs, webhooks and the billing worker (lib/supabase/service.ts). Never in pages or user actions.
SUPABASE_SERVICE_ROLE_KEY=

# GitHub App (phase 2). In Vercel the app needs only the public slug and client id (for
# links) and the webhook secret (to check deliveries). The App ID, client secret and
# private key are Supabase Edge Function secrets (`supabase secrets set`), used only by
# the github-link and github-worker functions; they may also sit here for local runs.
GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Email (Resend). EMAIL_FROM is the verified sender for the app's own security emails,
# e.g. "Skilient <security@your-domain>". Supabase Auth mail goes through Resend SMTP (dashboard).
RESEND_API_KEY=
EMAIL_FROM=

# Server only: HMAC key for IP hashes and rate-limit keys (any long random string, e.g. `openssl rand -hex 32`).
IP_HASH_SECRET=

# Cloudflare Turnstile (verified server-side; Cloudflare's test keys on Preview and local)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog (EU)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_PERSONAL_API_KEY=

# Payment gateways: key and webhook-secret names are added in phase 10, once the gateways are chosen.

# Dev only: serve the /ui gallery from a production build (CI E2E)
ENABLE_UI_GALLERY=
